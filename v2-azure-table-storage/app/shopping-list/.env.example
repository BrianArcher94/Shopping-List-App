# Copy to .env.local for local development. Do NOT commit real values.

# Switch the app onto the V2 Azure Functions API instead of LocalStorage.
# Leave false/unset until the Functions API is deployed. Has no effect in tests.
VITE_USE_API=false

# Base path/URL for the V2 REST API. Defaults to "/api" (same origin, routed by
# the Application Gateway to the Functions App). Override to hit a remote API
# during local dev, e.g. https://func-slt-v2-dev.azurewebsites.net/api
VITE_API_BASE_URL=/api

# Port the production SPA server (server.js) listens on. App Service sets this
# automatically (commonly 8080); only needed for local `npm start`.
PORT=8080

# Target for server.js's /api reverse proxy. server.js forwards same-origin
# /api/* requests to this Function App base URL (no path rewrite; the Functions
# runtime already serves under /api). Set automatically as an App Service app
# setting by Terraform (terraform/main.wapp.tf). For local `npm start` against a
# remote API, set e.g. https://slatbl-dv-fnap-ukw-001.azurewebsites.net
# Leave unset to disable the proxy (e.g. when running the SPA on LocalStorage).
API_PROXY_TARGET=
