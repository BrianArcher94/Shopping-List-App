# Copy to .env.local for local development. Do NOT commit real values.

# Switch the app onto the Function App REST API instead of LocalStorage.
# Baked in at build time (the container image is built with this set to true).
# Has no effect in tests.
VITE_USE_API=false

# Base path/URL for the REST API. Defaults to "/api" (same origin; server.js
# proxies it to the Function App). Override to hit a remote API during local dev.
VITE_API_BASE_URL=/api

# Port the production SPA server (server.js) listens on. The container image
# defaults to 8080; only needed for local `npm start`.
PORT=8080

# Target for server.js's /api reverse proxy. server.js forwards same-origin
# /api/* requests to this Function App base URL (no path rewrite; the Functions
# runtime already serves under /api). In Azure it is set as a Container App env
# var by Terraform. For local runs against `func start`, use http://localhost:7071
# (or http://host.docker.internal:7071 from inside a container).
# Leave unset to disable the proxy (e.g. when running the SPA on LocalStorage).
API_PROXY_TARGET=
