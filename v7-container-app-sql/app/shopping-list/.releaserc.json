{
  "branches": ["main"],
  "tagFormat": "web-v${version}",
  "extends": "semantic-release-monorepo",
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "node -e \"require('fs').writeFileSync(process.env.NEXT_VERSION_FILE, '${nextRelease.version}')\""
      }
    ]
  ]
}
