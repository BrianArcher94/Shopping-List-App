# ======================================================================
# Shopping List Tracker — Version 4 (Azure Web App + Azure SQL + Azure AD B2C)
# Stack: React / Vite / Azure Functions (Node) / Terraform
# ======================================================================

# --- Operating system ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.ntvs*
*.njsproj
*.sw?

# --- Environment & secrets (never commit these) ---
# B2C: never commit client secrets, signing/encryption keys or tenant policy keys.
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.pfx
*.p12
secrets.json
secrets.*.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Node / Vite / React ---
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
.eslintcache
.cache/
.turbo/
*.tsbuildinfo

# --- Azure Functions (local dev) ---
local.settings.json
bin/
obj/
# Azurite storage emulator artifacts
__azurite_db*__.json
__blobstorage__/
__queuestorage__/
__azurite*__
.azurite/

# --- Azure ---
.azure/
*.publishsettings
*.PublishSettings

# --- Terraform ---
**/.terraform/*
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# tfvars often hold sensitive values — commit a *.tfvars.example instead.
# Delete these 3 lines if you intentionally version non-secret tfvars.
*.tfvars
*.tfvars.json
!*.tfvars.example
# NOTE: keep .terraform.lock.hcl committed (provider lock) — do NOT ignore it.

# --- Claude Code ---
.claude/settings.local.json
